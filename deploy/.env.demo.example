# AICTE FDR Portal — Example Demo Environment Template (Sprint 2 Track 2)
# To generate real secure values, run: python scripts/gen_secrets.py -o deploy/.env.demo
FASTAPI_ENV=demo
PROJECT_NAME="AICTE Security Deposit / FDR Portal (DEMO)"
DOMAIN=localhost

# Cryptographic Keys (guarded against default/weak values in demo & production)
# Must be at least 32 bytes and non-default
SECRET_KEY=replace_with_32_byte_random_secret_key_abcdef12345
VAULT_KEY=replace_with_valid_32_byte_base64_encoded_encryption_key==

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password_98765
POSTGRES_DB=app

# Initial Administrator Account
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace_with_strong_admin_password_12345

# Email & Notifications (Mailpit simulated SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAILS_FROM_EMAIL=noreply@fdr.aicte-india.org
EMAILS_FROM_NAME="AICTE FDR Regulatory System"
