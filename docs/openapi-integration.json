{
  "components": {
    "schemas": {
      "BankConfirmationFields": {
        "properties": {
          "amount_paise": {
            "exclusiveMinimum": 0.0,
            "title": "Amount Paise",
            "type": "integer"
          },
          "bank_code": {
            "title": "Bank Code",
            "type": "string"
          },
          "lien_marked": {
            "default": true,
            "title": "Lien Marked",
            "type": "boolean"
          },
          "maturity_date": {
            "format": "date",
            "title": "Maturity Date",
            "type": "string"
          },
          "ref_no": {
            "title": "Ref No",
            "type": "string"
          }
        },
        "required": [
          "ref_no",
          "bank_code",
          "amount_paise",
          "maturity_date"
        ],
        "title": "BankConfirmationFields",
        "type": "object"
      },
      "BankConfirmationRequest": {
        "properties": {
          "fields": {
            "$ref": "#/components/schemas/BankConfirmationFields"
          },
          "request_token": {
            "title": "Request Token",
            "type": "string"
          },
          "signed_letter_base64": {
            "title": "Signed Letter Base64",
            "type": "string"
          }
        },
        "required": [
          "request_token",
          "signed_letter_base64",
          "fields"
        ],
        "title": "BankConfirmationRequest",
        "type": "object"
      },
      "CursorPage": {
        "properties": {
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "CursorPage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SandboxSignRequest": {
        "properties": {
          "amount_paise": {
            "title": "Amount Paise",
            "type": "integer"
          },
          "bank_code": {
            "default": "SBIN",
            "title": "Bank Code",
            "type": "string"
          },
          "lien_marked": {
            "default": true,
            "title": "Lien Marked",
            "type": "boolean"
          },
          "maturity_date": {
            "format": "date",
            "title": "Maturity Date",
            "type": "string"
          },
          "ref_no": {
            "title": "Ref No",
            "type": "string"
          }
        },
        "required": [
          "ref_no",
          "amount_paise",
          "maturity_date"
        ],
        "title": "SandboxSignRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebhookCreateRequest": {
        "properties": {
          "event_types": {
            "items": {
              "type": "string"
            },
            "title": "Event Types",
            "type": "array"
          },
          "secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret"
          },
          "target_url": {
            "title": "Target Url",
            "type": "string"
          }
        },
        "required": [
          "target_url"
        ],
        "title": "WebhookCreateRequest",
        "type": "object"
      }
