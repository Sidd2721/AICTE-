# .env.example - template for environment variables
# Generate keys:
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# VAULT_KEY:  python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="FDR Portal (AICTE PS 26265)"

SECRET_KEY=changethis-at-least-32-characters-long-key
VAULT_KEY=changethis-replace-with-real-32-byte-base64-key
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres - app role for runtime, migrator role for Alembic migrations
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://app:change-me-app@localhost:5432/app
MIGRATION_DATABASE_URL=postgresql://migrator:change-me-migrator@localhost:5432/app
